# Congress-data local development env vars
# Copy to .env and fill in values

# Congress.gov API
CONGRESS_API_KEY=

# Dagster
DAGSTER_CODE_LOCATION=congress_data

# LLM (via LiteLLM proxy or direct)
LLM_MODEL=runpod/qwen3:30b-a3b
LLM_BASE_URL=http://litellm.talos00:4000/v1
LLM_API_KEY=
LLM_MAX_TOKENS=8192

# Embeddings (local Mac via LiteLLM)
EMBEDDING_MODEL=ollama-mac/nomic-embed-text
EMBEDDING_BASE_URL=http://litellm.talos00:4000/v1
EMBEDDING_DIMENSIONS=768

# S3 / MinIO
DAGSTER_S3_ENDPOINT_URL=http://minio.talos00
DAGSTER_S3_ACCESS_KEY=minio
DAGSTER_S3_SECRET_KEY=minio123
DAGSTER_S3_BUCKET=catalyst-data
