# syntax=docker/dockerfile:1
# ---------- GPU variant: OpenVINO + Intel i915 GPU ----------
# Build: docker build -f packages/media-ingest/Dockerfile.gpu -t media-ingest:gpu .
# Requires: gpu.intel.com/i915 resource in K8s pod spec
#
# Includes both faster-whisper (CPU fallback) and OpenVINO GenAI (GPU).
# Switch via config: whisper_backend="openvino", openvino_device="GPU"

# ---------- stage 1: build ----------
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app

# 1. Install shared libs
COPY libs/catalyst-contracts-core/ /tmp/catalyst-contracts-core/
COPY libs/dagster-io/              /tmp/dagster-io/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system /tmp/catalyst-contracts-core/ && \
    uv pip install --system /tmp/dagster-io/

# 2. Install package dependencies with OpenVINO extras
#    CPU-only PyTorch (for pyannote diarization — runs on CPU regardless)
COPY packages/media-ingest/pyproject.toml .
RUN --mount=type=cache,target=/root/.cache/uv \
    mkdir -p src/media_ingest && \
    touch src/media_ingest/__init__.py && \
    uv pip install --system \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        ".[openvino]" && \
    rm -rf src/media_ingest

# 3. Copy real source
COPY packages/media-ingest/src/ src/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --no-deps --reinstall-package media-ingest .

# ---------- stage 2: runtime (Ubuntu for Intel GPU repo compat) ----------
FROM ubuntu:24.04

# Install Python 3.12 + Intel GPU compute runtime
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3-pip \
        ffmpeg libsndfile1 libgomp1 \
        gnupg ca-certificates wget && \
    wget -qO- https://repositories.intel.com/gpu/intel-graphics.key | \
        gpg --dearmor -o /usr/share/keyrings/intel-graphics.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/intel-graphics.gpg] \
        https://repositories.intel.com/gpu/ubuntu-noble noble unified" \
        > /etc/apt/sources.list.d/intel-gpu.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ocl-icd-libopencl1 intel-opencl-icd \
        intel-level-zero-gpu level-zero && \
    apt-get purge -y gnupg wget && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy Python packages from builder (Debian layout) to Ubuntu layout
COPY --from=builder /usr/local/lib/python3.12/site-packages/ /usr/lib/python3/dist-packages/
COPY --from=builder /usr/local/bin/dagster /usr/local/bin/dagster

ENV DAGSTER_HOME=/opt/dagster/dagster_home
RUN mkdir -p $DAGSTER_HOME

EXPOSE 4000

CMD ["dagster", "code-server", "start", \
     "--host", "0.0.0.0", \
     "--port", "4000", \
     "--module-name", "media_ingest"]
