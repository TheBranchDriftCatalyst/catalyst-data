# Copy to dagster-s3-credentials.env (gitignored) and fill with dev
# MinIO values. Mirrors the ExternalSecret `dagster-s3-credentials`
# at k8s/talos00/externalsecret-s3.yaml (sourced from 1Password item
# `dagster-minio-s3` in prod).
DAGSTER_S3_ENDPOINT_URL=http://host.k3d.internal:9000
DAGSTER_S3_ACCESS_KEY=minio
DAGSTER_S3_SECRET_KEY=minio123
DAGSTER_S3_BUCKET=dagster
