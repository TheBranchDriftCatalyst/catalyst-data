---
# Local-dev secrets for the Dagster code locations (CD-48tr).
#
# Mirrors the prod catalyst-eso ExternalSecret pattern: a single Secret
# resource holding the runtime keys each code location needs. The
# Tiltfile reads this file via ``read_yaml()`` and pipes ``stringData``
# into the dagster-dev local_resource's serve_env. No shell sourcing
# of .envrc.* files needed — config (committed) lives in
# dagster-dev-config.yaml, secrets (gitignored) live here.
#
# Setup
#   cp dagster-dev-secrets.yaml.example dagster-dev-secrets.yaml
#   # Then fill in the values below from your secret store of choice:
#   #   1Password CLI:  op item get "<item>" --fields api_key
#   #   k3d cluster:    kubectl --context k3d-catalyst-dev get secret …
#   #   prod cluster:   kubectl --context talos00 get secret …
#
# Gitignored by `.gitignore` (k8s/local/dagster-dev-secrets.yaml is in
# the ignore list; this .example file is explicitly un-ignored).
#
# When containerizing the code locations in a future CD-48tr follow-on,
# this Secret can be mounted via envFrom directly — same data, same
# keys, no code change.
apiVersion: v1
kind: Secret
metadata:
  name: dagster-dev-secrets
  labels:
    app.kubernetes.io/name: dagster-dev-secrets
    app.kubernetes.io/part-of: catalyst-data
type: Opaque
stringData:
  # ── LLM (via LiteLLM proxy at http://litellm.talos00) ──────────
  # Same virtual key used by every code-location pod in prod. Pull
  # from the catalyst-cluster `llm-credentials` Secret OR the LiteLLM
  # UI at /ui (admin section, "Virtual Keys").
  LLM_API_KEY: "sk-litellm-REPLACE_ME"
  # OpenAI-compat alias — some code paths look for OPENAI_API_KEY
  # even when LLM_API_KEY is set (langchain default).
  OPENAI_API_KEY: "sk-litellm-REPLACE_ME"
  # Same key serves embeddings — proxy multiplexes by model.
  EMBEDDING_API_KEY: "sk-litellm-REPLACE_ME"

  # ── Congress.gov API ───────────────────────────────────────────
  # Free key from https://api.congress.gov/sign-up/ — quota 5k/hour.
  CONGRESS_API_KEY: "REPLACE_ME"

  # ── HuggingFace (for pyannote diarization model download) ──────
  # Required ONLY when running media_diarization on first boot.
  # Free token from https://huggingface.co/settings/tokens with
  # read-only scope.
  HF_TOKEN: "hf_REPLACE_ME"
