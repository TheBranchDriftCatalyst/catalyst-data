__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.ruff_cache/
.scratch/
*.egg
.pytest_cache/

# Test output — all integration test outputs go here
.test-output/
tests/pipeline-output/
tests/__pipeline-output/
tests/congress-pipeline-output/
tests/fixtures/model_cache/
tests/demo_video.mp4

# Media-ingest video fixtures — large binaries (~100s of MB each compressed via
# AV1/HEVC), regenerable by re-downloading from metube via audio_manifest.yaml
# and running scripts/fixtures/compress_fixtures.py. The audio_manifest.yaml IS committed
# (small YAML pinning doc_id → filename → source URL).
packages/media-ingest/tests/fixtures/*.mp4
packages/media-ingest/tests/fixtures/*.mkv
packages/media-ingest/tests/fixtures/*.webm
packages/media-ingest/tests/fixtures/*.mov

# Legacy test scratch
packages/media-ingest/tests/.output/

.env
.env.*
.envrc
.envrc.cluster
.envrc.local
**/.envrc

# Local-only secret material consumed by `kustomize build k8s/local`
# and the Tiltfile's `read_yaml('k8s/local/dagster-dev-secrets.yaml')`.
# Examples (*.example) ARE committed — copy them to the un-suffixed
# name and fill in. The dagster-dev-secrets.yaml file mirrors the prod
# catalyst-eso ExternalSecret pattern but renders locally without ESO.
k8s/local/*.env
!k8s/local/*.env.example
k8s/local/dagster-dev-secrets.yaml
!k8s/local/dagster-dev-secrets.yaml.example

# Local dev mirror of the prod NFS data root (see CATALYST_DATA_ROOT).
# Tilt provisions this with symlinks to test fixtures + a writable
# whisper model cache.
.dev-data/

.coverage
*.executed.ipynb
.DS_Store
*.tsbuildinfo
*.png
.playwright-mcp/
.claude/
scripts/lib/
.tmp_dagster_home_*/

# Dolt-backed beads server runtime state (process files + local DB checkout).
# The issues themselves live in .beads/issues.jsonl (committed); everything
# under .beads/dolt/ is a per-machine dolt checkout, and the dolt-server.*
# files are process bookkeeping.
.beads/dolt/
.beads/dolt-server.*
.beads/dolt-config.log

# One-off analysis/report outputs (bloat reports, stat dumps, etc.).
reports/
