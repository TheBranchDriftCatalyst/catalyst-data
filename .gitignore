__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
.ruff_cache/
.scratch/
*.egg
.pytest_cache/

# Test output — all integration test outputs go here
.test-output/
tests/pipeline-output/
tests/__pipeline-output/
tests/congress-pipeline-output/
tests/fixtures/model_cache/
tests/demo_video.mp4

# Media-ingest video fixtures — large binaries (~100s of MB each compressed via
# AV1/HEVC), regenerable by re-downloading from metube via audio_manifest.yaml
# and running scripts/fixtures/compress_fixtures.py. The audio_manifest.yaml IS committed
# (small YAML pinning doc_id → filename → source URL).
packages/media-ingest/tests/fixtures/*.mp4
packages/media-ingest/tests/fixtures/*.mkv
packages/media-ingest/tests/fixtures/*.webm
packages/media-ingest/tests/fixtures/*.mov

# Legacy test scratch
packages/media-ingest/tests/.output/

.env
.env.*
.envrc
.envrc.cluster
.envrc.local
**/.envrc

# Local-only secret material consumed by `kustomize build k8s/local`.
# Examples (*.env.example) ARE committed — copy them to *.env and fill in.
k8s/local/*.env
!k8s/local/*.env.example
.coverage
*.executed.ipynb
.DS_Store
*.tsbuildinfo
*.png
.playwright-mcp/
.claude/
scripts/lib/
